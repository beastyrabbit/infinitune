{
  "name": "infinitune",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm exec concurrently --kill-others-on-fail -n web,server -c blue,magenta \"pnpm dev:web\" \"LOG_TO_FILE=1 LOG_EVENT_BUS=1 WORKER_DIAGNOSTICS=1 pnpm dev:server\"",
    "dev:all": "pnpm dev",
    "dev:web": "PORTLESS_PORT=1355 NODE_EXTRA_CA_CERTS=$HOME/.portless/ca.pem VITE_API_URL=https://api-infinitune.localhost:1355 ./node_modules/.bin/portless web-infinitune pnpm -C apps/web dev",
    "dev:server": "PORTLESS_PORT=1355 NODE_EXTRA_CA_CERTS=$HOME/.portless/ca.pem API_URL=https://api-infinitune.localhost:1355 APP_ORIGIN=https://web-infinitune.localhost:1355 RATE_LIMIT_TRUSTED_PROXY_IPS=127.0.0.1,::1 ./node_modules/.bin/portless api-infinitune pnpm -C apps/server dev",
    "dev:web:portless": "pnpm dev:web",
    "dev:server:portless": "pnpm dev:server",
    "dev:all:portless": "pnpm dev:all",
    "dev:web:fallback": "VITE_API_URL=http://localhost:5175 pnpm -C apps/web dev",
    "dev:server:fallback": "RATE_LIMIT_TRUSTED_PROXY_IPS=127.0.0.1,::1 pnpm -C apps/server dev",
    "dev:all:fallback": "pnpm exec concurrently --kill-others-on-fail -n web,server -c blue,magenta \"pnpm dev:web:fallback\" \"LOG_TO_FILE=1 LOG_EVENT_BUS=1 WORKER_DIAGNOSTICS=1 pnpm dev:server:fallback\"",
    "infi": "pnpm -C apps/cli infi",
    "build": "pnpm --filter @infinitune/web build",
    "check": "biome check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "tag:mp3s": "tsx --env-file=.env.local scripts/tag-mp3s.ts",
    "react:doctor": "pnpm exec react-doctor . --yes --project @infinitune/web"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.7.11",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.58",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/router-plugin": "^1.168.40",
    "@tanstack/store": "^0.11.1",
    "amqplib": "^0.10.9",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.9",
    "lucide-react": "^0.561.0",
    "motion": "^12.43.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260213-154614-f663e76d",
    "ollama-ai-provider-v2": "^3.6.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "streamdown": "^1.6.11",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "ws": "^8.21.3",
    "zod": "4.2.1",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@tanstack/devtools-event-client": "^0.4.4",
    "@tanstack/devtools-vite": "^0.3.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/amqplib": "^0.10.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.4",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^27.4.0",
    "portless": "^0.4.2",
    "react-doctor": "^0.0.28",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "web-vitals": "^5.3.0"
  }
}
